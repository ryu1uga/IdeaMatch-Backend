# Copia este archivo como .env y ajusta los valores.
# docker compose lee este archivo automáticamente.

# ---- Puertos publicados en tu equipo (docker compose) ----
API_PORT=3000
DB_PORT=5432

# ---- App ----
NODE_ENV=development
PORT=3000

# Usado por `npm run dev` y la CLI de Prisma desde Windows (fuera de Docker).
# Si cambias DB_PORT, cámbialo también aquí.
DATABASE_URL="postgresql://ideamatch:ideamatch@localhost:5432/ideamatch?schema=public"
# En Supabase: pooler en modo sesión (puerto 5432) con ?sslmode=require (ver README > Despliegue).
# Opcional: certificado CA de la BD (PEM; se aceptan "\n" literales) para validar el SSL.
DATABASE_CA_CERT=

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="1d"

CORS_ORIGIN="*"

# ---- Seguridad ----
# Proxies delante de la API: 0 en local, 1 en Render (para que el rate limit vea la IP real)
TRUST_PROXY=0
# Intentos por IP cada 15 minutos en /api/auth/login y /api/auth/register
AUTH_RATE_LIMIT=20

# ---- Archivos (foto de perfil, adjuntos del chat) ----
# Con CLOUDINARY_URL los archivos van a Cloudinary (obligatorio en Render: su disco se borra).
# Se copia del dashboard de Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Sin CLOUDINARY_URL se guardan en UPLOAD_DIR y se sirven en /uploads (solo desarrollo).
CLOUDINARY_URL=
UPLOAD_DIR=uploads
# URL pública de la API para armar las URLs de archivos locales (opcional)
PUBLIC_URL=

# ---- Administrador inicial (lo crea `npm run db:seed`; opcional) ----
# Si la cuenta ya existe, solo se marca como admin (no cambia su contraseña).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
