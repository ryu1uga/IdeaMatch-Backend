# Copia este archivo como .env y ajusta los valores.
# docker compose lee este archivo automáticamente.

# ---- Puertos publicados en tu equipo (docker compose) ----
API_PORT=3000
DB_PORT=5432

# ---- App ----
NODE_ENV=development
PORT=3000

# Usado por `npm run dev` y la CLI de Prisma desde Windows (fuera de Docker).
# Si cambias DB_PORT, cámbialo también aquí.
DATABASE_URL="postgresql://ideamatch:ideamatch@localhost:5432/ideamatch?schema=public"

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="1d"

CORS_ORIGIN="*"
